# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every value is optional for READ scripts:
# they fall back to public endpoints. WRITE scripts require PRIVATE_KEY.
# ---------------------------------------------------------------------------

# Solana RPC URL. Read by createConnection(). Defaults to public mainnet-beta.
SOLANA_RPC=

# Path to a local Solana keypair FILE, used by write scripts (e.g.
# meteora/open-position). Loaded lazily — read scripts run fine without it.
# Point it at your `solana-keygen` / `solana config` id.json. `~` is expanded.
#   e.g. ~/.config/solana/id.json  or  ~/solana/id.json
KEYPAIR_PATH=~/.config/solana/id.json

# Jupiter Portal API key. Read by createJupiterClient(). Omit to use the free
# lite-api.jup.ag host (fine for examples).
JUPITER_API_KEY=

# DAS / Helius endpoint. Read by getDasEndpoint() for asset queries.
SOLANA_DAS_ENDPOINT=
