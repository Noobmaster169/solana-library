{
  "name": "solana-defi-library",
  "version": "0.1.0",
  "description": "A combined simplicity layer for reading Solana protocols: core Solana queries, Jupiter APIs, and Meteora DLMM — clean, batched, copy-pasteable functions, plus a script harness to exercise each feature against a live RPC.",
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./solana": "./src/solana/index.ts",
    "./jupiter": "./src/jupiter/index.ts",
    "./meteora": "./src/meteora/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "script": "tsx scripts/run.ts",
    "smoke": "tsx scripts/run.ts all"
  },
  "keywords": [
    "solana",
    "web3",
    "rpc",
    "jupiter",
    "meteora",
    "dlmm",
    "defi",
    "beet",
    "spl-token",
    "das"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "axios": "^1.7.0",
    "bignumber.js": "^9.1.2",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
