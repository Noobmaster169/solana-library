{
  "name": "solana-library",
  "version": "0.1.0",
  "description": "A simplicity layer for querying Solana: fetch raw account bytes, parse them with fixed beet layouts, and batch RPC queries efficiently.",
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx examples/smoke.ts"
  },
  "keywords": [
    "solana",
    "web3",
    "rpc",
    "beet",
    "spl-token",
    "das",
    "helius"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "axios": "^1.7.0",
    "bignumber.js": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
